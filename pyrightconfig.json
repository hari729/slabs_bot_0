{
  "include": [
    "src"
  ],
  "exclude": [
    "**/build",
    "**/install",
    "**/log",
    "**/__pycache__"
  ],
  "extraPaths": [
    "install/my_inters/lib/python3.12/site-packages",
    "/opt/ros/humble/lib/python3.10/site-packages"
  ],
  "typeCheckingMode": "basic",
  "reportPrivateImportUsage": "none",
  "reportUnusedCallResult": "none",
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux"
}
