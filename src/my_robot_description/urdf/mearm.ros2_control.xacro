<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg default="false" name="use_mearm_mock_hardware"></xacro:arg>
  <ros2_control name="mearm_ros2_control" type="system">
    <hardware>
      <xacro:if value="$(arg use_mearm_mock_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_mearm_mock_hardware)">
        <plugin>mearm_hardware/MeArmHardwareInterface</plugin>
        <param name="serial_port">/dev/serial/by-id/usb-Arduino__www.arduino.cc__0043_75033303335351D0D010-if00</param>
        <param name="baud_rate">115200</param>
      </xacro:unless>
    </hardware>
    <!-- mearm_joint_0: base continuous-rotation servo. Command is speed -1..+1. -->
    <joint name="mearm_joint_0">
      <command_interface name="position">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"></state_interface>
      <state_interface name="velocity"></state_interface>
    </joint>
    <!-- mearm_joint_1: shoulder, URDF range -1.57..1.0 rad.
         Servo mapping: servo = -1.0 * q + 1.5707963. -->
    <joint name="mearm_joint_1">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.0</param>
        <param name="scale">-1.0</param>
        <param name="offset">1.5707963</param>
      </command_interface>
      <state_interface name="position"></state_interface>
      <state_interface name="velocity"></state_interface>
    </joint>
    <!-- mearm_joint_2: elbow, URDF range 0.0..1.57 rad.
         Servo mapping: servo = -1.0 * q + 1.5707963. -->
    <joint name="mearm_joint_2">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">1.57</param>
        <param name="scale">-1.0</param>
        <param name="offset">1.5707963</param>
      </command_interface>
      <state_interface name="position"></state_interface>
      <state_interface name="velocity"></state_interface>
    </joint>
    <!-- mearm_joint_3: claw, URDF range 0.0..1.57 rad.
         Servo mapping: servo = 0.1667512 * q + 1.3962634. -->
    <joint name="mearm_joint_3">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">1.57</param>
        <param name="scale">0.1667512</param>
        <param name="offset">1.3962634</param>
      </command_interface>
      <state_interface name="position"></state_interface>
      <state_interface name="velocity"></state_interface>
    </joint>
  </ros2_control>
</robot>
