<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_mearm_mock_hardware" default="true"/>

  <ros2_control name="mearm_ros2_control" type="system">
    <hardware>
      <xacro:if value="$(arg use_mearm_mock_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_mearm_mock_hardware)">
        <plugin>mearm_hardware/MeArmHardwareInterface</plugin>
        <param name="serial_port">/dev/serial/by-id/usb-Arduino__www.arduino.cc__0043_85633323032351D0A181-if00</param>
        <param name="baud_rate">115200</param>
      </xacro:unless>
    </hardware>

    <joint name="mearm_joint_0">
      <command_interface name="position">
        <param name="min">-0.7853</param>
        <param name="max">0.7853</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="mearm_joint_1">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="mearm_joint_2">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="mearm_joint_3">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
