<launch>
  <let name="urdf_path" value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro"></let>
  <let name="rviz_config_path" value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz"></let>
  <node exec="robot_state_publisher" pkg="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"></param>
  </node>
  <node exec="joint_state_publisher_gui" pkg="joint_state_publisher_gui"></node>
  <node args="-d $(var rviz_config_path)" exec="rviz2" output="screen" pkg="rviz2"></node>
</launch>
