<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>esp32_hardware</name>
  <version>0.1.0</version>
  <description>
    ros2_control hardware interface for ESP32 differential drive over USB serial.
    Reads encoder ticks and sends wheel RPM setpoints using a simple text protocol.
  </description>
  <maintainer email="user@todo.todo">kompor</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
