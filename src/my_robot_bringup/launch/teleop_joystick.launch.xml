<launch>
  <!-- Joystick teleop for Jazzy. Mirrors teleop_keyboard.launch.xml -->
  <let name="rviz_config_path" value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz"/>
  <arg name="joy_dev" default="/dev/input/js0" description="Joystick device"/>

  <!-- Joy driver: publishes /joy messages -->
  <node pkg="joy" exec="joy_node" name="joy_node" output="screen">
    <param name="dev" value="$(var joy_dev)"/>
    <param name="deadzone" value="0.05"/>
    <param name="autorepeat_rate" value="20.0"/>
  </node>

  <!-- Teleop node: maps /joy axes to /diff_drive_controller/cmd_vel -->
  <node pkg="teleop_twist_joy" exec="teleop_node" name="teleop_twist_joy" output="screen">
    <param name="publish_stamped_twist" value="true"/>
    <param name="require_enable_button" value="false"/>

    <!-- Default Xbox-style layout -->
    <param name="axis_linear.x" value="1"/>
    <param name="axis_angular.yaw" value="0"/>

    <param name="scale_linear.x" value="0.5"/>
    <param name="scale_linear_turbo.x" value="1.0"/>
    <param name="scale_angular.yaw" value="1.0"/>
    <param name="scale_angular_turbo.yaw" value="2.0"/>

    <!-- Hold LB (button 4) for turbo. -1 disables the enable button. -->
    <param name="enable_button" value="-1"/>
    <param name="enable_turbo_button" value="4"/>

    <remap from="cmd_vel" to="/diff_drive_controller/cmd_vel"/>
  </node>

  <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config_path)" output="screen"/>
</launch>
