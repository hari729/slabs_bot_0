<launch>
  <let name="rviz_config_path" value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz"></let>
  <node args="-d $(var rviz_config_path)" exec="rviz2" output="screen" pkg="rviz2"></node>

  <!-- Keyboard teleop for wheels + MeArm -->
  <node exec="teleop_keyboard" launch-prefix="xterm -e" name="teleop_keyboard" output="screen" pkg="my_robot_teleop">
    <param name="stamped" value="true"></param>
    <!-- Wheel velocity scales, mirroring the previous teleop_twist_keyboard values -->
    <param name="speed" value="0.5"></param>
    <param name="turn" value="2.0"></param>
    <param name="speed_limit" value="1.0"></param>
    <param name="turn_limit" value="3.0"></param>
    <!-- Arm control tuning -->
    <param name="arm_step" value="0.05"></param>
    <param name="arm_base_speed" value="0.2"></param>
    <param name="arm_base_timeout" value="0.5"></param>
    <remap from="cmd_vel" to="/diff_drive_controller/cmd_vel"></remap>
  </node>
</launch>
