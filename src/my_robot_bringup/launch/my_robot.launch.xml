<launch>
  <let name="urdf_path" value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro"></let>
  <node exec="robot_state_publisher" pkg="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"></param>
  </node>
  <node exec="ros2_control_node" pkg="controller_manager">
    <param from="$(find-pkg-share my_robot_bringup)/config/my_robot_controllers.yaml"></param>
  </node>
  <node args="joint_state_broadcaster" exec="spawner" pkg="controller_manager"></node>
  <node args="diff_drive_controller" exec="spawner" pkg="controller_manager"></node>
</launch>
